var collectionAssetId =
  'projects/thermal-growing-seasons/assets/RabiKharifMetrics_1951_1980_' +
  P.ASSET_SUFFIX + '_v20';
var driveFolder = 'RabiKharifMetrics_v20_' + P.ASSET_SUFFIX;
var descPrefix  = 'RabiKharifMetrics_v20_' + P.ASSET_SUFFIX + '_';

for (var _y = startYear; _y <= endYear; _y++) {
  var _yearStr = ('0000' + _y).slice(-4);
  var _img = computeYearMetrics(ee.Number(_y));
  if (EXPORT_TO_ASSET) {
    Export.image.toAsset({
      image: _img,
      description: descPrefix + _yearStr,
      assetId: collectionAssetId + '/' + _yearStr,
      scale: 11132,
      region: fullGeometry,
      crs: 'EPSG:4326',
      maxPixels: 1e13,
      pyramidingPolicy: {'.default': 'sample'}
    });
  }
  if (EXPORT_TO_DRIVE) {
    Export.image.toDrive({
      image: _img,
      description: 'Drive_v20_' + P.ASSET_SUFFIX + '_' + _yearStr,
      folder: driveFolder,
      fileNamePrefix: descPrefix + _yearStr,
      scale: 11132,
      region: fullGeometry,
      crs: 'EPSG:4326',
      maxPixels: 1e13,
      fileFormat: 'GeoTIFF'
    });
  }
}

