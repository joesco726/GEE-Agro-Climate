// PART 1 — EXPORT YEARLY COLLECTION (v1.3)
// ======================================================
var collectionAssetId =
  'projects/thermal-growing-seasons/assets/RabiMetrics_1951_1980_' +
  P.ASSET_SUFFIX + '_v13';
var driveFolder = 'RabiMetrics_v13_' + P.ASSET_SUFFIX;
var descPrefix  = 'RabiMetrics_v13_' + P.ASSET_SUFFIX + '_';
var yearsList   = ee.List.sequence(startYear, endYear);

yearsList.evaluate(function(years) {
  years.forEach(function(y) {
    var yearStr = ('0000' + y).slice(-4);
    var img = computeYearMetrics(ee.Number(y));
    if (EXPORT_TO_ASSET) {
      Export.image.toAsset({
        image: img,
        description: descPrefix + yearStr,
        assetId: collectionAssetId + '/' + yearStr,
        scale: 11132,
        region: fullGeometry,
        crs: 'EPSG:4326',
        maxPixels: 1e13,
        pyramidingPolicy: {'.default': 'sample'}
      });
    }
    if (EXPORT_TO_DRIVE) {
      Export.image.toDrive({
        image: img,
        description: 'RabiDrive_v13_' + P.ASSET_SUFFIX + '_' + yearStr,
        folder: driveFolder,
        fileNamePrefix: descPrefix + yearStr,
        scale: 11132,
        region: fullGeometry,
        crs: 'EPSG:4326',
        maxPixels: 1e13,
        fileFormat: 'GeoTIFF'
      });
    }
  });
});

