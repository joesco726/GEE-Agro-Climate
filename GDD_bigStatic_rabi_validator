var currentPixels = ALL_REF_PIXELS[HEMISPHERE];

// Build FeatureCollection for batch sampling
var refFC = ee.FeatureCollection(currentPixels.map(function(p) {
  return ee.Feature(ee.Geometry.Point([p.lon, p.lat]), {site: p.name});
}));

// Sample all bands at all reference points in one server call
var sampled = img.sampleRegions({
  collection: refFC,
  scale: 11132,
  tileScale: 4,
  geometries: false
});
print('── C: Reference pixel values ──');
print('(full band table — use inspector or expand below)', sampled);

// Compact chart: key timing and GDD bands across all reference pixels
var CHART_BANDS = [
  'rabi_sow_irr', 'rabi_harvest_doy', 'rabi_gdd0_irr', 'rabi_gdd10_irr',
  'rabi_yield_mult_irr_pct', 'kharif_gdd10_irr', 'kharif_precip_mm', 'vern_zone'
];
if (IS_V11) CHART_BANDS = CHART_BANDS.concat(['kharif_gdd10_pp_irr', 'kharif_gdd10_pp_irr_2nd']);

print(ui.Chart.feature.byFeature({
  features: sampled.select(CHART_BANDS),
  xProperty: 'site',
  yProperties: CHART_BANDS
}).setChartType('Table').setOptions({title: 'Reference pixel values — key bands'}));

// ================================================================
// SECTION D — PASS/FAIL + FAO CALENDAR COMPARISON
// ================================================================
sampled.evaluate(function(fc) {
  print('');
  print('══════════════════════════════════════════════════════════════');
  print('  SECTION D: Crop-system PASS/FAIL + FAO calendar benchmarks');
  print('══════════════════════════════════════════════════════════════');

  if (!fc || !fc.features || fc.features.length === 0) {
    print('[ERROR] No features returned — pixels may be masked or outside RABI_MASK.');
    return;
  }

  var pass = 0, fail = 0, warn = 0;

  fc.features.forEach(function(feat) {
    var v    = feat.properties;
    var name = v['site'];
    var meta = null;
    currentPixels.forEach(function(p) { if (p.name === name) meta = p; });
    if (!meta) return;

    print('');
    print('▶ ' + name + ' — ' + meta.desc);

    // Internal consistency checks (always run)
    var matLeHarv = (v['rabi_maturity_doy'] !== null) && (v['rabi_harvest_doy'] !== null)
      && (v['rabi_maturity_doy'] <= v['rabi_harvest_doy']);
    var rainLeIrrGDD0 = (v['rabi_gdd0_rain'] !== null) && (v['rabi_gdd0_irr'] !== null)
      && (v['rabi_gdd0_rain'] <= v['rabi_gdd0_irr']);
    var rainLeIrrGDD10 = (v['rabi_gdd10_rain'] !== null) && (v['rabi_gdd10_irr'] !== null)
      && (v['rabi_gdd10_rain'] <= v['rabi_gdd10_irr']);
    var sowRainGeSowIrr = (v['rabi_sow_rain'] !== null) && (v['rabi_sow_irr'] !== null)
      && (v['rabi_sow_rain'] >= v['rabi_sow_irr']);
    var kRainGeKStart = (v['kharif_rain_start_doy'] !== null) && (v['kharif_start_doy'] !== null)
      && (v['kharif_rain_start_doy'] >= v['kharif_start_doy']);

    function tag(b) { return b ? '[PASS]' : '[FAIL]'; }
    if (!matLeHarv)     { print(tag(matLeHarv)  + ' maturity ≤ harvest: mat=' + v['rabi_maturity_doy'] + ', harv=' + v['rabi_harvest_doy']); fail++; }
    else { pass++; }
    if (!rainLeIrrGDD0) { print(tag(rainLeIrrGDD0) + ' gdd0_rain ≤ gdd0_irr: rain=' + Math.round(v['rabi_gdd0_rain']) + ', irr=' + Math.round(v['rabi_gdd0_irr'])); fail++; }
    else { pass++; }
    if (!sowRainGeSowIrr) { print(tag(sowRainGeSowIrr) + ' sow_rain ≥ sow_irr: rain=' + v['rabi_sow_rain'] + ', irr=' + v['rabi_sow_irr']); fail++; }
    else { pass++; }

    // FAO calendar comparison
    if (meta.fao_sow) {
      var sowOK   = v['rabi_sow_irr'] >= meta.fao_sow[0] - 15 && v['rabi_sow_irr'] <= meta.fao_sow[1] + 15;
      print((sowOK ? '[PASS]' : '[WARN]') + ' sow_irr = ' + v['rabi_sow_irr']
        + '  FAO window: ' + meta.fao_sow[0] + '–' + meta.fao_sow[1] + ' (±15 d tolerance)');
      if (!sowOK) warn++;
    }
    if (meta.fao_harv) {
      var harvOK  = v['rabi_harvest_doy'] >= meta.fao_harv[0] - 20 && v['rabi_harvest_doy'] <= meta.fao_harv[1] + 20;
      print((harvOK ? '[PASS]' : '[WARN]') + ' harvest_doy = ' + v['rabi_harvest_doy']
        + '  FAO window: ' + meta.fao_harv[0] + '–' + meta.fao_harv[1] + ' (±20 d tolerance)');
      if (!harvOK) warn++;
    }

    // Band range checks
    Object.keys(meta.chk).forEach(function(band) {
      var lo = meta.chk[band][0], hi = meta.chk[band][1];
      var val = v[band];
      if (val === null || val === undefined) {
        print('[WARN] ' + band + ' = null (masked or band absent)'); warn++; return;
      }
      var ok = (val >= lo && val <= hi);
      if (ok) { pass++; } else { fail++; }
      print((ok ? '[PASS]' : '[FAIL]') + ' ' + band + ' = ' + Math.round(val)
        + '  [' + lo + '–' + hi + ']');
    });

    // Derived diagnostics (contextual, not hard PASS/FAIL)
    if (v['rabi_gdd0_irr'] !== null) {
      print('  » rabi_gdd0_irr ≥ 1600 (wheat viable)? '
        + (v['rabi_gdd0_irr'] >= 1600 ? 'YES' : 'NO — marginal or rice/barley system'));
      print('  » rabi_gdd10_irr ≥ 1800 (rice in rabi viable)? '
        + (v['rabi_gdd10_irr'] >= 1800 ? 'YES' : 'NO — too cold for traditional rice in rabi'));
    }
    if (v['kharif_gdd10_irr'] !== null) {
      print('  » kharif_gdd10_irr ≥ 1800 (rice/maize viable in kharif)? '
        + (v['kharif_gdd10_irr'] >= 1800 ? 'YES' : 'NO — marginal'));
      print('  » kharif_gdd10_irr ≥ 3200 (double rice gate)? '
        + (v['kharif_gdd10_irr'] >= 3200 ? 'YES — 2nd crop computation would fire' : 'NO — gate not met'));
    }
    if (IS_V11 && v['kharif_gdd10_pp_irr'] !== null && v['kharif_gdd10_irr'] > 0) {
      var ratio = v['kharif_gdd10_pp_irr'] / v['kharif_gdd10_irr'];
      print('  » ppMod ratio (kharif) = ' + ratio.toFixed(3)
        + ' — rice DL suppression at this latitude: ' + Math.round((1-ratio)*100) + '%');
    }
    if (IS_V11 && v['kharif_gdd10_pp_irr_2nd'] !== null) {
      print('  » kharif_gdd10_pp_irr_2nd = ' + Math.round(v['kharif_gdd10_pp_irr_2nd'])
        + (v['kharif_gdd10_pp_irr_2nd'] > 900 ? ' — 2nd rice crop viable' : ' — insufficient for 2nd crop'));
    }
    if (v['rabi_gdd0_irr'] !== null && v['rabi_gdd0_rain'] !== null) {
      print('  » irr−rain GDD0 gap = ' + Math.round(v['rabi_gdd0_irr'] - v['rabi_gdd0_rain'])
        + ' (large = moisture-limited; small = rainfed adequate)');
    }
    var kharifLen = (v['kharif_end_doy'] !== null && v['kharif_start_doy'] !== null)
      ? Math.round(v['kharif_end_doy'] - v['kharif_start_doy']) : null;
    if (kharifLen !== null) {
      print('  » kharif window = ' + kharifLen + ' d  ('
        + v['kharif_start_doy'] + '–' + v['kharif_end_doy'] + ')');
    }
  });

  print('');
  print('══ D summary: PASS=' + pass + '  FAIL=' + fail + '  WARN=' + warn + ' ══');
});

// ================================================================
// SECTION E — CROSS-BAND SPATIAL CONSISTENCY (image-level)
// ================================================================
// Each flag is 1 where the condition FAILS (0=consistent). Reduce to
// pixel count over the sanity geometry at coarse scale (55km = fast).
print('');
print('── E: Cross-band spatial consistency ──');

var flags = {
  'maturity_gt_harvest':   img.select('rabi_maturity_doy').gt(img.select('rabi_harvest_doy')),
  'rain_sow_lt_irr_sow':   img.select('rabi_sow_rain').lt(img.select('rabi_sow_irr')),
  'rain_gdd0_gt_irr_gdd0': img.select('rabi_gdd0_rain').gt(img.select('rabi_gdd0_irr')),
  'rain_gdd10_gt_irr_gdd10':img.select('rabi_gdd10_rain').gt(img.select('rabi_gdd10_irr')),
  'krain_before_kstart':   img.select('kharif_rain_start_doy').lt(img.select('kharif_start_doy')),
  'season_len_mismatch':   img.select('rabi_season_len_irr').subtract(
                             img.select('rabi_harvest_doy').subtract(img.select('rabi_sow_irr'))).abs().gt(2),
  'harvest_lt_sow':        img.select('rabi_harvest_doy').lt(img.select('rabi_sow_irr'))
};

// v1.1 specific consistency
if (IS_V11) {
  flags['pp_irr_exceeds_irr']   = img.select('kharif_gdd10_pp_irr').gt(img.select('kharif_gdd10_irr').multiply(1.01));
  flags['2nd_exceeds_pp_total'] = img.select('kharif_gdd10_pp_irr_2nd').gt(img.select('kharif_gdd10_pp_irr').multiply(1.01));
  flags['2nd_fires_below_gate'] = img.select('kharif_gdd10_pp_irr_2nd').gt(0)
    .and(img.select('kharif_gdd10_irr').lt(3200));
}

// Combine all flags and reduce to sum (failure pixel count)
var flagImg = ee.Image(Object.keys(flags).map(function(k) { return flags[k].rename(k); }))
  .unmask(0).toByte();

flagImg.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: SANITY_GEOM,
  scale: 55600,
  maxPixels: 1e9
}).evaluate(function(r) {
  print('Failure pixel counts (0 = fully consistent):');
  Object.keys(r).forEach(function(k) {
    var n = r[k];
    print((n === 0 ? '[PASS]' : '[FAIL]') + ' ' + k + ' — ' + n + ' pixels');
  });
});

// ================================================================
// SECTION F — GLOBAL DISTRIBUTION PERCENTILES
// ================================================================
// Key bands at P5/P25/P50/P75/P95 across the analysis belt.
// Compares distributional shape against expected agronomic ranges.
print('');
print('── F: Global distribution percentiles (p5/p25/p50/p75/p95) ──');

var DIST_BANDS = [
  'rabi_sow_irr', 'rabi_season_len_irr', 'rabi_gdd0_irr',
  'rabi_gdd10_irr', 'rabi_yield_mult_irr_pct',
  'rabi_drought_frac_pct', 'rabi_frost_days_0',
  'kharif_gdd10_irr', 'kharif_precip_mm', 'ptq_factor'
];
if (IS_V11) DIST_BANDS = DIST_BANDS.concat(['kharif_gdd10_pp_irr', 'kharif_gdd10_pp_irr_2nd']);

img.select(DIST_BANDS).reduceRegion({
  reducer: ee.Reducer.percentile([5, 25, 50, 75, 95]),
  geometry: SANITY_GEOM,
  scale: 55600,
  maxPixels: 1e9
}).evaluate(function(r) {
  DIST_BANDS.forEach(function(b) {
    var p5=r[b+'_p5'], p25=r[b+'_p25'], p50=r[b+'_p50'], p75=r[b+'_p75'], p95=r[b+'_p95'];
    if (p50 === null || p50 === undefined) { print('[skip] ' + b + ' — no data'); return; }
    print(b + ':  p5=' + Math.round(p5) + '  p25=' + Math.round(p25)
      + '  p50=' + Math.round(p50) + '  p75=' + Math.round(p75) + '  p95=' + Math.round(p95));
  });
  // Agronomic interpretations
  if (r['rabi_gdd0_irr_p50'] !== null) {
    print('» Median rabi_gdd0_irr (' + Math.round(r['rabi_gdd0_irr_p50']) + ') '
      + (r['rabi_gdd0_irr_p50'] >= 1600 ? '≥ 1600 — median pixel is wheat-viable' : '< 1600 — median pixel is marginal for wheat'));
    print('» rabi_gdd0_irr p95 (' + Math.round(r['rabi_gdd0_irr_p95']) + ') — cap on very warm/long-season pixels');
  }
  if (r['kharif_precip_mm_p50'] !== null) {
    print('» Median kharif_precip (' + Math.round(r['kharif_precip_mm_p50']) + ' mm) '
      + (r['kharif_precip_mm_p50'] >= 600 ? '≥ 600 mm — median pixel meets rainfed rice precip gate' : '< 600 mm — median pixel does not meet rice precip gate'));
  }
  if (IS_V11 && r['kharif_gdd10_pp_irr_2nd_p75'] !== null) {
    print('» kharif_gdd10_pp_irr_2nd p75 = ' + Math.round(r['kharif_gdd10_pp_irr_2nd_p75'])
      + ' (> 0 means top quartile of pixels support double rice)');
  }
});

// ================================================================
// SECTION G — ppMod EFFECT DIAGNOSTIC [v1.1 only]
// Quantifies rice photoperiod suppression as a function of latitude.
// Expected: ppRatio ≈ 1.0 at ≤ 20°N, declining to ~0.70-0.75 at 40°N.
// Suppression > 50% at any latitude indicates model parameters need review.
// ================================================================
if (IS_V11) {
  print('');
  print('── G: ppMod effect diagnostic (v1.1) ──');
  print('Expected ppRatio ≈ 1.00 at ≤20°N; ≈0.90 at 30°N; ≈0.75-0.80 at 40°N');

  var ppRatioImg = img.select('kharif_gdd10_pp_irr')
    .divide(img.select('kharif_gdd10_irr').max(1))
    .clamp(0, 1)
    .rename('ppmod_ratio');

  // Sample ppRatio at 5° latitude intervals along a longitude transect (80°E for NH; 20°E for SH)
  var transectLon = HEMISPHERE === 'NH' ? 80 : 25;
  var latSteps = HEMISPHERE === 'NH'
    ? [5, 10, 15, 20, 25, 30, 35, 40]
    : [-5, -10, -15, -20, -25, -30, -35];
  var transectPts = ee.FeatureCollection(latSteps.map(function(lat) {
    return ee.Feature(ee.Geometry.Point([transectLon, lat]), {lat: lat});
  }));
  var ppSampled = ppRatioImg.sampleRegions({collection: transectPts, scale: 55600, tileScale: 4});

  ppSampled.evaluate(function(fc) {
    if (!fc || !fc.features.length) { print('[WARN] No ppMod samples returned'); return; }
    print('Latitude transect ppMod ratio (rice DL suppression in kharif):');
    fc.features.forEach(function(f) {
      var lat  = f.properties['lat'];
      var r    = f.properties['ppmod_ratio'];
      if (r === null || r === undefined) { print('  lat=' + lat + '°  → masked'); return; }
      var pct  = Math.round((1 - r) * 100);
      var bar  = new Array(Math.round(pct / 5) + 1).join('█');
      var ok   = r >= 0.5;
      print((ok ? '  ' : '[W] ') + 'lat=' + (lat > 0 ? '+' : '') + lat + '°  ratio='
        + r.toFixed(3) + '  suppression=' + pct + '%  ' + bar);
    });
    print('(Suppression > 50% at any latitude warrants parameter review)');
  });

  // Also print global mean ppMod ratio to quantify overall suppression
  ppRatioImg.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: SANITY_GEOM,
    scale: 55600,
    maxPixels: 1e9
  }).evaluate(function(r) {
    if (r && r['ppmod_ratio'] !== null) {
      print('Global mean ppMod ratio over belt: ' + r['ppmod_ratio'].toFixed(3)
        + ' — avg ' + Math.round((1 - r['ppmod_ratio']) * 100) + '% rice GDD suppression in kharif');
    }
  });
}

// ================================================================
// SECTION H — DOUBLE-CROP ZONE VALIDATION [v1.1 only]
// Known double-rice zones (pre-industrial): Mekong Delta (10°N),
// Pearl River Delta (23°N), Kerala/Tamil Nadu (10°N), Bangladesh boro+aman.
// Expected: kharif_gdd10_pp_irr_2nd > 900 in these regions; ≈0 at >35°N.
// ================================================================
if (IS_V11) {
  print('');
  print('── H: Double-crop zone validation (v1.1) ──');

  var doubleCropImg  = img.select('kharif_gdd10_pp_irr_2nd');
  var doubleBinary   = doubleCropImg.gt(900);  // > 900 GDD10 = can sustain a 2nd rice crop

  // Area of double-crop potential zone (km²)
  var doubleCropArea = doubleBinary.multiply(ee.Image.pixelArea()).divide(1e6)
    .reduceRegion({reducer: ee.Reducer.sum(), geometry: SANITY_GEOM, scale: 55600, maxPixels: 1e9});
  doubleCropArea.evaluate(function(r) {
    var v = r[Object.keys(r)[0]];
    print('Area with kharif_gdd10_pp_irr_2nd > 900 GDD10: '
      + (v ? Math.round(v).toLocaleString() : 'n/a') + ' km²');
    print('(For reference: Mekong+Pearl+Kerala+Bangladesh rice zones ≈ 200,000-500,000 km²)');
  });

  // Distribution of 2nd crop GDD10 in pixels where gate fired
  doubleCropImg.updateMask(doubleCropImg.gt(0))
    .reduceRegion({
      reducer: ee.Reducer.percentile([25, 50, 75, 95]),
      geometry: SANITY_GEOM,
      scale: 55600,
      maxPixels: 1e9
    }).evaluate(function(r) {
      if (!r || r['kharif_gdd10_pp_irr_2nd_p50'] === null) {
        print('[INFO] No pixels with kharif_gdd10_pp_irr_2nd > 0 in this geometry');
        return;
      }
      print('2nd crop GDD10 distribution (where gate fired):');
      print('  p25=' + Math.round(r['kharif_gdd10_pp_irr_2nd_p25'])
        + '  p50=' + Math.round(r['kharif_gdd10_pp_irr_2nd_p50'])
        + '  p75=' + Math.round(r['kharif_gdd10_pp_irr_2nd_p75'])
        + '  p95=' + Math.round(r['kharif_gdd10_pp_irr_2nd_p95']));
      print('  » p50 ≥ 1800? ' + (r['kharif_gdd10_pp_irr_2nd_p50'] >= 1800
        ? 'YES — median double-crop pixel can support a full second rice crop'
        : 'NO — median double-crop pixel is marginal (not quite 1800 GDD10)'));
    });

  // Check specific known double-rice pixels
  var doublePts = ee.FeatureCollection([
    ee.Feature(ee.Geometry.Point([105.8,10.0]), {site:'Mekong_Delta'}),
    ee.Feature(ee.Geometry.Point([113.3,23.1]), {site:'Pearl_River_Delta'}),
    ee.Feature(ee.Geometry.Point([80.0,10.5]),  {site:'Kerala_India'}),
    ee.Feature(ee.Geometry.Point([90.4,23.7]),  {site:'Bangladesh_boro'})
  ]);
  img.select(['kharif_gdd10_irr','kharif_gdd10_pp_irr','kharif_gdd10_pp_irr_2nd'])
    .sampleRegions({collection: doublePts, scale: 11132, tileScale: 4})
    .evaluate(function(fc) {
      if (!fc || !fc.features.length) { print('[WARN] Double-crop point samples empty'); return; }
      print('Known double-rice zone spot checks:');
      fc.features.forEach(function(f) {
        var p = f.properties;
        var gateOK = p['kharif_gdd10_irr'] >= 3200;
        var viable = p['kharif_gdd10_pp_irr_2nd'] > 900;
        print('  ' + p['site'] + ': gdd10_irr=' + Math.round(p['kharif_gdd10_irr'])
          + ' [gate ' + (gateOK?'FIRES':'miss') + ']'
          + '  pp_irr=' + Math.round(p['kharif_gdd10_pp_irr'])
          + '  2nd_crop=' + Math.round(p['kharif_gdd10_pp_irr_2nd'])
          + ' [' + (viable?'viable':'marginal') + ']');
      });
    });
}

