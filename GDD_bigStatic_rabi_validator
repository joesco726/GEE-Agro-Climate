// ================================================================
// RABI DIAGNOSTIC VALIDATOR v2.0
// Compatible with asset v1.0 (37 bands) and v1.1 (41 bands).
//
// Sections:
//   A — Band presence
//   B — Spatial map layers (14 layers)
//   C — Reference pixel extraction (14 pixels, batch)
//   D — Crop-system PASS/FAIL with FAO calendar benchmarks
//   E — Cross-band spatial consistency (image-level flags)
//   F — Global distribution percentiles
//   G — ppMod effect diagnostic [v1.1]
//   H — Double-crop zone validation [v1.1]
//   I — 30-year time-series at anchor pixel [optional]
// ================================================================

// ── CONFIG ───────────────────────────────────────────────────────
var HEMISPHERE    = 'NH';    // 'NH' or 'SH'
var YEAR          = 1965;
var ASSET_VERSION = 'v12';  // 'v1' for v1.0  |  'v11' for v1.1
var LOAD_COLLECTION = false; // true → Section I time-series (slow)

var IS_V11 = (ASSET_VERSION === 'v11');

// ── ASSET LOAD ───────────────────────────────────────────────────
var HEMI_SUFFIX      = HEMISPHERE === 'NH' ? 'North' : 'South';
var ASSET_BASE       = 'projects/thermal-growing-seasons/assets/RabiMetrics_1951_1980_';
var SINGLE_ASSET_ID  = ASSET_BASE + HEMI_SUFFIX + '_' + ASSET_VERSION + '/' + YEAR;
var COLLECTION_ID    = ASSET_BASE + HEMI_SUFFIX + '_' + ASSET_VERSION;

var img = ee.Image(SINGLE_ASSET_ID).toFloat();
print('▶ Asset:', SINGLE_ASSET_ID);

var SANITY_GEOM = HEMISPHERE === 'NH'
  ? ee.Geometry.Polygon([[[-180, 0], [180, 0], [180, 42], [-180, 42]]], null, false)
  : ee.Geometry.Polygon([[[-180, -40], [180, -40], [180, 0], [-180, 0]]], null, false);

// ================================================================
// SECTION A — BAND PRESENCE
// ================================================================
var BANDS_V10 = [
  'rabi_gdd0_irr', 'rabi_gdd0_rain', 'rabi_gdd10_irr', 'rabi_gdd10_rain',
  'rabi_yield_mult_irr_pct', 'rabi_yield_mult_rain_pct',
  'rabi_drought_frac_pct', 'rabi_heat_frac_pct',
  'rabi_frost_days_0', 'rabi_frost_days_m2',
  'rabi_precip_mm', 'rabi_water_deficit_mm',
  'rabi_sow_irr', 'rabi_sow_rain', 'rabi_harvest_doy', 'rabi_maturity_doy',
  'rabi_season_len_irr', 'rabi_season_len_rain', 'ptq_factor',
  'kharif_gdd0_irr', 'kharif_gdd0_rain', 'kharif_gdd10_irr', 'kharif_gdd10_rain',
  'kharif_sorghum_yield_mult_pct', 'kharif_maize_yield_mult_pct',
  'kharif_rice_rain_yield_mult_pct', 'kharif_rice_irr_yield_mult_pct',
  'kharif_precip_mm', 'kharif_drought_days',
  'kharif_heat_stress_rain_gdd', 'kharif_heat_stress_irr_gdd',
  'kharif_start_doy', 'kharif_rain_start_doy', 'kharif_end_doy',
  'mean_min_soil_c', 'vern_zone', 'mean_vernal_progress'
];
var BANDS_V11 = BANDS_V10.concat([
  'kharif_gdd10_pp_irr', 'kharif_gdd10_pp_rain',
  'kharif_gdd10_pp_irr_2nd', 'kharif_gdd10_pp_rain_2nd'
]);
var EXPECTED_BANDS = IS_V11 ? BANDS_V11 : BANDS_V10;

img.bandNames().evaluate(function(actual) {
  print('── A: Band presence ──');
  var missing = EXPECTED_BANDS.filter(function(b) { return actual.indexOf(b) < 0; });
  var extra   = actual.filter(function(b) { return EXPECTED_BANDS.indexOf(b) < 0; });
  if (missing.length === 0) {
    print('[PASS] All ' + EXPECTED_BANDS.length + ' expected bands present');
  } else {
    print('[FAIL] Missing bands: ' + missing.join(', '));
  }
  if (extra.length) print('[WARN] Extra bands (unexpected): ' + extra.join(', '));
  print('Total bands in asset: ' + actual.length);
});

// ================================================================
// SECTION B — SPATIAL MAP LAYERS
// ================================================================
// Sowing window: NH Oct = DOY ~274, Dec = 365; SH Apr = DOY ~91, Jul = ~195
var sowPalette = ['#1a1aff','#00ccff','#00ff99','#ffff00','#ff8800'];
var sowRange   = HEMISPHERE === 'NH' ? [265, 365] : [60, 195];
Map.addLayer(img.select('rabi_sow_irr'),  {min:sowRange[0], max:sowRange[1], palette:sowPalette}, 'Rabi sow IRR');
Map.addLayer(img.select('rabi_sow_rain'), {min:sowRange[0], max:sowRange[1], palette:sowPalette}, 'Rabi sow RAIN');

// Harvest: NH Mar = 425, Jul = 577; SH Sep = 244, Dec = 365
var harvRange = HEMISPHERE === 'NH' ? [390, 570] : [240, 365];
Map.addLayer(img.select('rabi_harvest_doy'), {min:harvRange[0], max:harvRange[1], palette:['#003300','#009900','#ffff00','#ff9900','#ff0000']}, 'Rabi harvest DOY');

// Season length (days)
Map.addLayer(img.select('rabi_season_len_irr'), {min:60, max:280, palette:['#ffffcc','#a1dab4','#41b6c4','#2c7fb8','#253494']}, 'Rabi season length IRR (d)');

// GDD0 viability bands: <1300=too cold/short, 1300-1600=barley, >1600=wheat
var gdd0Palette = ['#440154','#31688e','#35b779','#fde725'];
Map.addLayer(img.select('rabi_gdd0_irr'),  {min:500, max:4000, palette:gdd0Palette}, 'Rabi GDD0 IRR');
Map.addLayer(img.select('rabi_gdd10_irr'), {min:0,   max:3000, palette:gdd0Palette}, 'Rabi GDD10 IRR (rice potential)');

// Rabi yield multiplier — irrigated
Map.addLayer(img.select('rabi_yield_mult_irr_pct'), {min:0, max:100, palette:['#d73027','#f46d43','#fee090','#74add1','#4575b4']}, 'Rabi yield mult IRR');

// Drought fraction — rainfed stress indicator
Map.addLayer(img.select('rabi_drought_frac_pct'), {min:0, max:100, palette:['#2166ac','#abd9e9','#ffffbf','#fdae61','#d73027']}, 'Rabi drought frac %');

// Kharif GDD10 — crop viability thresholds: 1800=rice/maize, 3200=double rice gate
var kharPalette = ['#1a1a2e','#16213e','#0f3460','#533483','#e94560','#f5a623','#f8e71c'];
Map.addLayer(img.select('kharif_gdd10_irr'), {min:0, max:5000, palette:kharPalette}, 'Kharif GDD10 IRR');

// Kharif rice rain yield
Map.addLayer(img.select('kharif_rice_rain_yield_mult_pct'), {min:0, max:100, palette:['#8b0000','#ff6600','#ffff00','#00cc44','#006622']}, 'Kharif rice rain yield %');

// Kharif precipitation
Map.addLayer(img.select('kharif_precip_mm'), {min:0, max:2500, palette:['#ffffb2','#fed976','#feb24c','#fd8d3c','#f03b20','#bd0026']}, 'Kharif precip mm');

// Vernalization zone
Map.addLayer(img.select('vern_zone'), {min:2, max:4, palette:['#e41a1c','#ff7f00','#4daf4a']}, 'Vern zone (2=cold 3=warm 4=tropical)');

// PTQ factor
Map.addLayer(img.select('ptq_factor'), {min:0.6, max:1.4, palette:['#8e0152','#c51b7d','#f1b6da','#fde0ef','#e6f5d0','#a1d76a','#4d9221']}, 'PTQ factor');

// v1.1 layers
if (IS_V11) {
  // ppMod ratio: kharif GDD10 with rice photoperiod suppression vs. without
  var ppRatio = img.select('kharif_gdd10_pp_irr')
    .divide(img.select('kharif_gdd10_irr').max(1))
    .clamp(0, 1);
  Map.addLayer(ppRatio, {min:0.5, max:1.0, palette:['#d73027','#f46d43','#fee090','#e0f3f8','#4575b4']}, 'v1.1 ppMod ratio (rice DL suppression)');

  // Double-crop: 2nd kharif sub-crop GDD10 — >900 = viable 2nd crop
  Map.addLayer(img.select('kharif_gdd10_pp_irr_2nd'), {min:0, max:2500, palette:['#111111','#2d004b','#762a83','#c2a5cf','#7fbf7b','#1b7837']}, 'v1.1 Kharif GDD10 2nd crop (0=gate not met)');
}

