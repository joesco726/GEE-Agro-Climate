// ======================================================
// FROST STATIC — Last spring / first autumn frost dates
// Pure air frost only: monthly Tmin_min < 0°C.
// (No soil temp or snow conflation with GDD_static_aggr safeBegin.)
//
// Uses ERA5-Land MONTHLY_AGGR temperature_2m_min (within-month
// minimum of daily Tmin). ~30× faster than daily approach.
// Precision: month-level (±~15 days intra-month), acceptable for
// climatological scheduling against bands with ±20–30 day variance.
//
// DOY assignment (conservative):
//   Spring months → end-of-month DOY (latest possible frost in month).
//   Autumn months → start-of-month DOY (earliest possible frost in month).
//
// last_spring_frost_p80: heading safe after this DOY in 80% of years.
// first_autumn_frost_p20: harvest safe before this DOY in 80% of years.
//   (Symmetric conservative bounds — p80 for spring, p20 for autumn.)
//
// spring_frost_years / autumn_frost_years (0–30): count of years where
// any frost was detected in each window. Use to gate reliability:
//   = 0  → never frosted; DOY bands are sentinels only.
//   < 5  → rare frost; DOY statistics unreliable.
//   ≥ 15 → frost occurs most years; statistics robust.
//
// Sentinels (no frost detected in window):
//   last_spring_frost  NH = 0,   SH = 366
//   first_autumn_frost NH = 366, SH = 0
//
// Change HEMISPHERE at top. Run once per hemisphere.
// ======================================================

var HEMISPHERE = 'NH';  // ←←← CHANGE TO 'NH' or 'SH'

// End-of-month DOY (used for spring — conservative late-frost estimate)
var MONTH_END_DOY   = {1:31, 2:59, 3:90, 4:120, 5:151, 6:181,
                       7:212, 8:243, 9:273, 10:304, 11:334, 12:365};
// Start-of-month DOY (used for autumn — conservative early-frost estimate)
var MONTH_START_DOY = {1:1, 2:32, 3:60, 4:91, 5:121, 6:152,
                       7:183, 8:214, 9:244, 10:274, 11:305, 12:335};

var HEMI_PARAMS = {
  NH: {
    // NH spring = Jan–Jun; autumn = Jul–Dec
    SPRING_MONTHS: [1, 2, 3, 4, 5, 6],
    AUTUMN_MONTHS: [7, 8, 9, 10, 11, 12],
    NO_SPRING_FROST:  0,    // sentinel: spring always frost-free
    NO_AUTUMN_FROST:  366,  // sentinel: autumn never frosted
    REGION: ee.Geometry.Polygon([[
      [-179.99, -10], [179.99, -10], [179.99, 75], [-179.99, 75]
    ]], null, false)
  },
  SH: {
    // SH spring = Jul–Dec (post-pivot); autumn = Jan–Jun (pre-pivot)
    SPRING_MONTHS: [7, 8, 9, 10, 11, 12],
    AUTUMN_MONTHS: [1, 2, 3, 4, 5, 6],
    NO_SPRING_FROST:  366,
    NO_AUTUMN_FROST:  0,
    REGION: ee.Geometry.Polygon([[
      [-179.99, -55], [179.99, -55], [179.99, 0], [-179.99, 0]
    ]], null, false)
  }
};
var P = HEMI_PARAMS[HEMISPHERE];

var START_YEAR = 1951;
var END_YEAR   = 1980;

// ── Masks ──────────────────────────────────────────────────────────────────
var pureClimaticMask = ee.Image('projects/thermal-growing-seasons/assets/ThermalGSL_5C_01deg')
  .select(0).unmask(0);
var oceanMask = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')
  .first().select('soil_temperature_level_1').mask().not();
var computeMask = pureClimaticMask.and(oceanMask.not());

// ── Per-year frost DOY computation (monthly resolution) ────────────────────
var perYear = ee.ImageCollection(
  ee.List.sequence(START_YEAR, END_YEAR).map(function(y) {
    var yearlyMonthly = ee.ImageCollection('ECMWF/ERA5_LAND/MONTHLY_AGGR')
      .filter(ee.Filter.calendarRange(y, y, 'year'))
      .select('temperature_2m_min');

    // ── Spring: last month with frost → assign end-of-month DOY ──────────
    // If coldest night of month M was above 0°C, no frost occurred in M.
    var springFrostDoys = ee.ImageCollection(
      P.SPRING_MONTHS.map(function(m) {
        var tminC = yearlyMonthly
          .filter(ee.Filter.calendarRange(m, m, 'month'))
          .first()
          .subtract(273.15);
        var frostOccurred = tminC.lt(0);
        // End-of-month DOY: conservative (latest possible frost in that month)
        return ee.Image.constant(MONTH_END_DOY[m]).updateMask(frostOccurred);
      })
    );
    var lastSpringFrost = springFrostDoys
      .reduce(ee.Reducer.max())
      .unmask(P.NO_SPRING_FROST)
      .rename('last_spring_frost');

    // ── Autumn: first month with frost → assign start-of-month DOY ───────
    // Start-of-month DOY: conservative (earliest possible frost in that month)
    var autumnFrostDoys = ee.ImageCollection(
      P.AUTUMN_MONTHS.map(function(m) {
        var tminC = yearlyMonthly
          .filter(ee.Filter.calendarRange(m, m, 'month'))
          .first()
          .subtract(273.15);
        var frostOccurred = tminC.lt(0);
        return ee.Image.constant(MONTH_START_DOY[m]).updateMask(frostOccurred);
      })
    );
    var firstAutumnFrost = autumnFrostDoys
      .reduce(ee.Reducer.min())
      .unmask(P.NO_AUTUMN_FROST)
      .rename('first_autumn_frost');

    // Frost-occurred flags: 1 if any frost detected this year, 0 if not.
    // Uses sentinel comparison so no extra filtering needed.
    var hadSpringFrost = lastSpringFrost.neq(P.NO_SPRING_FROST).rename('had_spring_frost');
    var hadAutumnFrost = firstAutumnFrost.neq(P.NO_AUTUMN_FROST).rename('had_autumn_frost');

    return lastSpringFrost
      .addBands(firstAutumnFrost)
      .addBands(hadSpringFrost)
      .addBands(hadAutumnFrost)
      .updateMask(computeMask);
  })
);

// ── 30-year statistics ─────────────────────────────────────────────────────
var lastSpringFrostMean = perYear.select('last_spring_frost')
  .reduce(ee.Reducer.mean()).round().rename('last_spring_frost_mean');

// p80: frost-free after this DOY in 80% of years → schedule heading after this.
var lastSpringFrostP80 = perYear.select('last_spring_frost')
  .reduce(ee.Reducer.percentile([80])).round().rename('last_spring_frost_p80');

var firstAutumnFrostMean = perYear.select('first_autumn_frost')
  .reduce(ee.Reducer.mean()).round().rename('first_autumn_frost_mean');

// p20: harvest safe before this DOY in 80% of years (frost arrives after p20
// in 80% of years → symmetric conservative bound to last_spring_frost_p80).
var firstAutumnFrostP20 = perYear.select('first_autumn_frost')
  .reduce(ee.Reducer.percentile([20])).round().rename('first_autumn_frost_p20');

// Frost frequency bands: years (out of 30) with at least one frost detected.
var springFrostYears = perYear.select('had_spring_frost')
  .reduce(ee.Reducer.sum()).toByte().rename('spring_frost_years');
var autumnFrostYears = perYear.select('had_autumn_frost')
  .reduce(ee.Reducer.sum()).toByte().rename('autumn_frost_years');

// ── Final image ────────────────────────────────────────────────────────────
var frostStatic = lastSpringFrostMean
  .addBands(lastSpringFrostP80)
  .addBands(firstAutumnFrostMean)
  .addBands(firstAutumnFrostP20)
  .addBands(springFrostYears)
  .addBands(autumnFrostYears)
  .unmask(0)
  .clip(P.REGION);

// ── Export ─────────────────────────────────────────────────────────────────
Export.image.toAsset({
  image: frostStatic,
  description: 'FrostStatic_1951_1980_' + HEMISPHERE,
  assetId: 'projects/thermal-growing-seasons/assets/FrostStatic_' + HEMISPHERE,
  scale: 11132,
  region: P.REGION,
  crs: 'EPSG:4326',
  maxPixels: 1e13,
  pyramidingPolicy: {'.default': 'sample'}
});

print('✅ Frost static started for ' + HEMISPHERE);
print('Asset: projects/thermal-growing-seasons/assets/FrostStatic_' + HEMISPHERE);
print('Source: ERA5-Land MONTHLY_AGGR temperature_2m_min (~30× faster than daily)');
print('Precision: month-level (±~15 days intra-month); conservative DOY assignment.');
print('Bands:');
print('  last_spring_frost_mean  — mean last-frost month end-DOY in spring window');
print('  last_spring_frost_p80   — p80: heading safe after this in 80% of years');
print('  first_autumn_frost_mean — mean first-frost month start-DOY in autumn window');
print('  first_autumn_frost_p20  — p20: harvest safe before this in 80% of years');
print('  spring_frost_years      — years (0–30) with spring frost (reliability flag)');
print('  autumn_frost_years      — years (0–30) with autumn frost (reliability flag)');
print('Spring months : ' + P.SPRING_MONTHS.join(', '));
print('Autumn months : ' + P.AUTUMN_MONTHS.join(', '));
