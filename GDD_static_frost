// ======================================================
// FROST STATIC — Last spring / first autumn frost dates
// Pure air frost: Tmin < 0°C. Day-level precision via a
// two-pass monthly→daily approach:
//
//   Pass 1 (monthly): ERA5-Land MONTHLY_AGGR temperature_2m_min.
//     Per pixel, identifies which months had any frost
//     (monthly tmin_min < 0°C). Acts as a per-pixel gate.
//
//   Pass 2 (daily): ERA5-Land DAILY_AGGR temperature_2m_min.
//     Loaded for all months but per-pixel results are masked
//     to zero where the monthly gate shows no frost. GEE's
//     lazy evaluation skips daily computation for those pixels,
//     so only frost-possible pixels incur daily cost.
//
// Gate is applied inside the per-image map() so GEE's lazy
// evaluator can skip tile reads before the reduce, not after.
// In subtropical zones (bulk of the valid rabi mask area),
// most spring months are frost-free → effective daily pixel
// compute is a small fraction of the naive all-daily approach.
//
// No soil temp or snow conflation (unlike GDD_static_aggr safeBegin).
//
// last_spring_frost_p80: heading safe after this DOY in 80% of years.
// first_autumn_frost_p20: harvest safe before this DOY in 80% of years.
//   (Symmetric conservative bounds — p80 spring, p20 autumn.)
//
// spring_frost_years / autumn_frost_years (0–30): years with any frost.
//   = 0  → never frosted; DOY bands are sentinels only.
//   < 5  → rare frost; DOY statistics unreliable.
//   ≥ 15 → frost occurs most years; statistics robust.
//
// Sentinels (no frost found in window):
//   NH: last_spring_frost = 0,   first_autumn_frost = 366
//   SH: last_spring_frost = 366, first_autumn_frost = 0
//
// Change HEMISPHERE at top. Run once per hemisphere.
// ======================================================

var HEMISPHERE = 'NH';  // ←←← CHANGE TO 'NH' or 'SH'

var HEMI_PARAMS = {
  NH: {
    SPRING_MONTHS: [1, 2, 3, 4, 5, 6],   // Jan–Jun
    AUTUMN_MONTHS: [7, 8, 9, 10, 11, 12], // Jul–Dec
    NO_SPRING_FROST:  0,
    NO_AUTUMN_FROST:  366,
    REGION: ee.Geometry.Polygon([[
      [-179.99, -10], [179.99, -10], [179.99, 75], [-179.99, 75]
    ]], null, false)
  },
  SH: {
    SPRING_MONTHS: [7, 8, 9, 10, 11, 12], // Jul–Dec (SH spring end)
    AUTUMN_MONTHS: [1, 2, 3, 4, 5, 6],    // Jan–Jun (SH autumn start)
    NO_SPRING_FROST:  366,
    NO_AUTUMN_FROST:  0,
    REGION: ee.Geometry.Polygon([[
      [-179.99, -55], [179.99, -55], [179.99, 0], [-179.99, 0]
    ]], null, false)
  }
};
var P = HEMI_PARAMS[HEMISPHERE];

var START_YEAR = 1951;
var END_YEAR   = 1980;

// ── Masks ──────────────────────────────────────────────────────────────────
var pureClimaticMask = ee.Image('projects/thermal-growing-seasons/assets/ThermalGSL_5C_01deg')
  .select(0).unmask(0);
// ERA5-Land native land mask from temperature_2m_min at a fixed date.
// Using the same variable and collection as the frost calculations ensures
// perfect consistency with what ERA5-Land will actually provide per pixel.
// Direct land mask (no double negation) is more robust over SH ocean.
var landMask = ee.ImageCollection('ECMWF/ERA5_LAND/MONTHLY_AGGR')
  .filterDate('2000-01-01', '2001-01-01')
  .first()
  .select('temperature_2m_min')
  .mask();
var computeMask = pureClimaticMask.and(landMask);

// ── Per-year frost DOY computation ─────────────────────────────────────────
var perYear = ee.ImageCollection(
  ee.List.sequence(START_YEAR, END_YEAR).map(function(y) {

    // Pass 1: monthly tmin_min masked to computeMask up-front. This propagates
    // ocean/non-compute masking into monthGate, which is then applied inside
    // the daily map() so lazy eval can skip ocean tile reads entirely.
    var monthlyTmin = ee.ImageCollection('ECMWF/ERA5_LAND/MONTHLY_AGGR')
      .filter(ee.Filter.calendarRange(y, y, 'year'))
      .select('temperature_2m_min')
      .map(function(img) { return img.updateMask(computeMask); });

    // ── Spring: last day in spring window where Tmin < 0°C ───────────────
    var springLastFrostPerMonth = ee.ImageCollection(
      P.SPRING_MONTHS.map(function(m) {
        // Pass 1 gate: per pixel, was the coldest night in month m below 0°C?
        // If not, no frost occurred in month m at that pixel → skip daily.
        var monthGate = monthlyTmin
          .filter(ee.Filter.calendarRange(m, m, 'month'))
          .first()
          .subtract(273.15)
          .lt(0);   // 1 where frost possible this month, 0 where definitely none

        // Pass 2: daily scan for month m — find last frost DOY.
        // GEE lazy eval: pixels where monthGate=0 are masked before compute,
        // so their daily images are not actually processed.
        var lastFrostDoyInMonth = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')
          .filter(ee.Filter.calendarRange(y, y, 'year'))
          .filter(ee.Filter.calendarRange(m, m, 'month'))
          .select('temperature_2m_min')
          .map(function(img) {
            var tminC = img.subtract(273.15);
            var doy = ee.Image.constant(
              ee.Date(img.get('system:time_start')).getRelative('day', 'year').add(1)
            ).toInt32();
            // Gate applied here so lazy eval can skip tile reads for frost-free pixels.
            return doy.updateMask(tminC.lt(0)).updateMask(monthGate);
          })
          .reduce(ee.Reducer.max());

        return lastFrostDoyInMonth;
      })
    );

    // Across all spring months: latest frost DOY this year.
    // Left masked where no frost occurred — collection reducers will skip
    // masked pixels so only frost-present years contribute to statistics.
    var lastSpringFrost = springLastFrostPerMonth
      .reduce(ee.Reducer.max())
      .rename('last_spring_frost');

    // ── Autumn: first day in autumn window where Tmin < 0°C ──────────────
    var autumnFirstFrostPerMonth = ee.ImageCollection(
      P.AUTUMN_MONTHS.map(function(m) {
        var monthGate = monthlyTmin
          .filter(ee.Filter.calendarRange(m, m, 'month'))
          .first()
          .subtract(273.15)
          .lt(0);

        var firstFrostDoyInMonth = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')
          .filter(ee.Filter.calendarRange(y, y, 'year'))
          .filter(ee.Filter.calendarRange(m, m, 'month'))
          .select('temperature_2m_min')
          .map(function(img) {
            var tminC = img.subtract(273.15);
            var doy = ee.Image.constant(
              ee.Date(img.get('system:time_start')).getRelative('day', 'year').add(1)
            ).toInt32();
            // Gate applied here so lazy eval can skip tile reads for frost-free pixels.
            return doy.updateMask(tminC.lt(0)).updateMask(monthGate);
          })
          .reduce(ee.Reducer.min());

        return firstFrostDoyInMonth;
      })
    );

    var firstAutumnFrost = autumnFirstFrostPerMonth
      .reduce(ee.Reducer.min())
      .rename('first_autumn_frost');

    // .mask() returns 1 where the reduce found frost (valid pixel), 0 where masked.
    // The output of .mask() is itself fully unmasked, so 0-values are valid counts.
    var hadSpringFrost = lastSpringFrost.mask().byte().rename('had_spring_frost');
    var hadAutumnFrost = firstAutumnFrost.mask().byte().rename('had_autumn_frost');

    return lastSpringFrost
      .addBands(firstAutumnFrost)
      .addBands(hadSpringFrost)
      .addBands(hadAutumnFrost)
      .updateMask(computeMask);
  })
);

// ── 30-year statistics ─────────────────────────────────────────────────────
// Reducers skip masked pixels, so only years with actual frost contribute to
// DOY statistics. Pixels never frosted stay masked after reduce → unmask with
// sentinel so NH/SH conventions are preserved and downstream masking works.
var lastSpringFrostMean = perYear.select('last_spring_frost')
  .reduce(ee.Reducer.mean()).round()
  .unmask(P.NO_SPRING_FROST).rename('last_spring_frost_mean');

// p80: frost-free after this DOY in 80% of frost years → schedule heading after this.
var lastSpringFrostP80 = perYear.select('last_spring_frost')
  .reduce(ee.Reducer.percentile([80])).round()
  .unmask(P.NO_SPRING_FROST).rename('last_spring_frost_p80');

var firstAutumnFrostMean = perYear.select('first_autumn_frost')
  .reduce(ee.Reducer.mean()).round()
  .unmask(P.NO_AUTUMN_FROST).rename('first_autumn_frost_mean');

// p20: conservative early bound — frost arrives after this DOY in 80% of frost years.
var firstAutumnFrostP20 = perYear.select('first_autumn_frost')
  .reduce(ee.Reducer.percentile([20])).round()
  .unmask(P.NO_AUTUMN_FROST).rename('first_autumn_frost_p20');

// Frost frequency: count of frost years (0–30). had_* are 0/1 and always unmasked
// within computeMask, so sum is correct whether or not frost occurred.
var springFrostYears = perYear.select('had_spring_frost')
  .reduce(ee.Reducer.sum()).toByte().unmask(0).rename('spring_frost_years');
var autumnFrostYears = perYear.select('had_autumn_frost')
  .reduce(ee.Reducer.sum()).toByte().unmask(0).rename('autumn_frost_years');

// ── Final image ────────────────────────────────────────────────────────────
var frostStatic = lastSpringFrostMean
  .addBands(lastSpringFrostP80)
  .addBands(firstAutumnFrostMean)
  .addBands(firstAutumnFrostP20)
  .addBands(springFrostYears)
  .addBands(autumnFrostYears)
  .unmask(0)
  .clip(P.REGION);

// ── Export ─────────────────────────────────────────────────────────────────
Export.image.toAsset({
  image: frostStatic,
  description: 'FrostStatic_1951_1980_' + HEMISPHERE,
  assetId: 'projects/thermal-growing-seasons/assets/FrostStatic_' + HEMISPHERE,
  scale: 11132,
  region: P.REGION,
  crs: 'EPSG:4326',
  maxPixels: 1e13,
  pyramidingPolicy: {'.default': 'sample'}
});

print('✅ Frost static started for ' + HEMISPHERE);
print('Asset: projects/thermal-growing-seasons/assets/FrostStatic_' + HEMISPHERE);
print('Method: monthly pre-filter (MONTHLY_AGGR tmin_min) + daily precision (DAILY_AGGR tmin_min).');
print('Daily computation skipped per-pixel for months where monthly tmin_min ≥ 0°C.');
print('Bands:');
print('  last_spring_frost_mean  — mean last frost DOY (day precision) in spring window');
print('  last_spring_frost_p80   — p80: heading safe after this in 80% of years');
print('  first_autumn_frost_mean — mean first frost DOY (day precision) in autumn window');
print('  first_autumn_frost_p20  — p20: harvest safe before this in 80% of years');
print('  spring_frost_years      — years (0–30) with spring frost detected');
print('  autumn_frost_years      — years (0–30) with autumn frost detected');
print('Reliability: DOY bands unreliable where frost_years < 5; sentinel-only where = 0');
print('Spring months : ' + P.SPRING_MONTHS.join(', '));
print('Autumn months : ' + P.AUTUMN_MONTHS.join(', '));
